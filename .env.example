# -----------------------------------------------------------------------------
# GitLab Server Configuration
# -----------------------------------------------------------------------------
CI_SERVER_URL=https://gitlab.grzegorz-pietrzak.pl/
REGISTRATION_TOKEN=your-registration-token-here

# -----------------------------------------------------------------------------
# Configuration Method Selection
# -----------------------------------------------------------------------------
# OPTION 1: Use JSON config file (recommended for multiple distinct runners)
# Point to your runners.json file location
RUNNER_CONFIG_FILE=/etc/gitlab-runner/runners.json

# OPTION 2: Use environment variables (simple setup for identical runners)
# Uncomment these if NOT using runners.json

# Number of runners to create (all will have identical config)
# RUNNER_COUNT=5

# Runner naming (will append -1, -2, -3, etc.)
# RUNNER_NAME_PREFIX=yakuza-runner

# Runner configuration (applies to all runners)
# RUNNER_TAGS=docker,yakuza,auto-scaled
# RUNNER_LIMIT=1
# DOCKER_IMAGE=docker:24.0.5
# DOCKER_PRIVILEGED=true
# DOCKER_VOLUMES=/var/run/docker.sock:/var/run/docker.sock,/cache
# DOCKER_PULL_POLICY=if-not-present
# REQUEST_CONCURRENCY=1

# Resource limits (optional, leave empty for unlimited)
# DOCKER_CPUS=2
# DOCKER_MEMORY=4g

# -----------------------------------------------------------------------------
# Docker Shared Memory Size (optional)
# -----------------------------------------------------------------------------
# DOCKER_SHM_SIZE=0
